{
  "name": "aajki-clone",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Aajki frontend clone + backend (Aajki proxy and server-side sentiment admin portal).",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
