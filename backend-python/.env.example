# Bharat Foreseez API configuration. Copy to .env for local use (never commit .env).

# development | test | staging | production. Staging/production enforce the required values below.
APP_ENV=development

# Postgres in production (e.g. postgresql://user:pass@host/db?sslmode=require).
# Empty in development = local SQLite file backend-python/local.db.
DATABASE_URL=

# Browser origins allowed to call the API, comma separated. Required outside development.
# ALLOWED_ORIGINS=https://bharatforeseez.example,https://staging.bharatforeseez.example
ALLOWED_ORIGINS=

# Admin bootstrap. While no admin account exists, signing in with ADMIN_USER / ADMIN_PASSWORD
# creates the first Super Admin, who must then set up two-factor sign-in and can add the other
# admins. Once any admin account exists these values sign nobody in (they can then be removed).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Hours an admin stays signed in.
ADMIN_SESSION_HOURS=12

# Shared secret for the scheduled headline refresh (Vercel Cron sends "Bearer <secret>").
CRON_SECRET=

# Hours a headline stays in the public ticker.
TICKER_WINDOW_HOURS=48

# Emergency switch: when true, the live chance on every election-sensitive question is withheld.
# Normal use is per-state quiet periods in the admin panel (Regions & flags).
ELECTION_QUIET_PERIOD=false

# App update prompts.
MIN_SUPPORTED_BUILD=1
LATEST_BUILD=1

# Statutory Grievance Officer shown in the app, plus legal links (from counsel).
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_OFFICER_ADDRESS=
PRIVACY_NOTICE_URL=
TERMS_URL=

# Points economy (spec defaults). The daily reward cap and rank thresholds can also be set in
# the admin panel, which takes precedence.
SIGNUP_REWARD=1000
CHECKIN_REWARD=50
QUIZ_REWARD=25
DAILY_REWARD_CAP=200
DAILY_CALL_CAP=10
CALL_MIN_POINTS=10
CALL_MAX_POINTS=500
DISPUTE_WINDOW_HOURS=48
SESSION_REMINDER_MINUTES=30

# Only behind a proxy you control that overwrites X-Forwarded-For (automatic on Vercel).
TRUST_PROXY_HEADERS=false

# Error reporting (optional). No personal data is attached to events.
SENTRY_DSN=
