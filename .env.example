# All optional for local dev. Defaults target the real Aajki backend.
#
# ADMIN auth for the /admin sentiment portal (Basic Auth).
# Local dev with no password set: /admin is open on localhost only.
# Deployed (Vercel): SET ADMIN_PASSWORD or /admin returns 503 (stays closed, never open).
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me-strong
#
# AAJKI_API=https://app.getkalki.com
# AAJKI_CLIENT=web
# SENTIMENT_FEED_PAGES=6
# SENTIMENT_TTL_MS=120000
# PORT=8787               # local backend port (npm start / npm run dev:api)
# BACKEND_ORIGIN=http://127.0.0.1:8787   # where Vite proxies /api in dev

# VITE_API_BASE: point the frontend at your own backend (e.g. the Python one).
# Unset = use the Node proxy to Kalki. Set = call this URL directly.
# VITE_API_BASE=http://localhost:8000
