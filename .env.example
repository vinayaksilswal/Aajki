# Frontend (Vite) build-time settings. Copy to .env.local for local development.
#
# URL of the Bharat Foreseez API (backend-python). Required: the app has no offline
# or demo data and shows an error state when the API is unreachable.
# The backend's ALLOWED_ORIGINS must include the origin this app is served from.
VITE_API_BASE=http://localhost:8000

# App build number, compared with the server's MIN_SUPPORTED_BUILD / LATEST_BUILD to show
# a hard or soft update prompt. Increase it with every release.
VITE_APP_BUILD=1
